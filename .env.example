# Copiar a .env y completar. .env no se sube a git.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Solo servidor (Render), nunca en el frontend:
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Lector de planillas de excitatriz (primera versión: solo servidor local).
# No publicar estas claves ni colocarlas en el frontend.
# EXCITATRIZ_OCR_PROVIDER=gemini
# GEMINI_API_KEY=
# EXCITATRIZ_OCR_MODEL=gemini-3.1-flash-lite
# Alternativa OpenAI: establecer EXCITATRIZ_OCR_PROVIDER=openai y modelo gpt-4.1.
# OPENAI_API_KEY=
